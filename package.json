{
  "name": "russian-verse-live",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-local-server.mjs",
    "snapshot:template": "node scripts/snapshot-profiles.mjs",
    "snapshot:full": "node scripts/snapshot-profiles.mjs full",
    "snapshot:design": "node scripts/snapshot-profiles.mjs design",
    "snapshot:sizes": "node scripts/snapshot-profiles.mjs --sizes",
    "design": "node scripts/snapshot-profiles.mjs design",
    "compile:parser": "npx --yes esbuild src/bibleVerseParser.ts --bundle --format=esm --platform=browser --outfile=parser.js",
    "compile:interpreter": "npx --yes esbuild src/transcriptInterpreter.ts --bundle --format=esm --platform=browser --outfile=interpreter.js",
    "build:corpus": "node scripts/build-bible-corpus.mjs",
    "test": "node tests/parser.test.mjs && node tests/interpreter.test.mjs && node tests/audio-buffer.test.mjs && node tests/feedback.test.mjs && node tests/mic-test.test.mjs && node tests/whisper-session.test.mjs && node tests/static.test.mjs"
  }
}
